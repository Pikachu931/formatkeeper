{
  "name": "FormatKeeper",
  "short_name": "FormatKeeper",
  "description": "Markdown, GFM and LaTeX into clean rich text for Google Docs, Word and Notion.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1b1d2e",
